  "securitySemantics": [
    "Framework one-hour tokens with protected account/purpose/expiry envelope; explicit CSRF-protected POST, no token-return endpoint.",
    "User-row locks and current stamp checks prevent concurrent replay; successful account changes and security audit commit together.",
    "Reset/change/confirmation revoke all target-account sessions; reauthentication is five-minute session metadata and grants no company authority.",
    "Generic suppressed/unknown/eligible recovery response, minimum timing floor, per-account durable resend quotas and IP auth limiter.",
    "Encrypted recipient jobs, bounded fenced worker retries, stable capture IDs and terminal payload erasure; global account namespace separate from companies."
  ],
  "limitations": [
    "No real provider, actual email recipients, authenticated bounce callbacks or production mail activation.",
    "No hosted CI/CodeQL/container/selected-host certification or tenant cutover claimed.",
    "Recovery excludes unverified/MFA-enabled accounts; verification and future MFA recovery are separate flows.",
    "Frontend automation does not complete manual screen-reader/assistive-technology review.",
    "Local account capture remains at-least-once with sink deduplication, not exactly-once provider sending or distributed fairness."
