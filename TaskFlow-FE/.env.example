# Development server only; not exposed as a VITE_ browser variable.
TASKFLOW_API_TARGET=http://localhost:5140
# For authentication use HTTPS on both Vite and the API. See docs/authentication.md.
# TASKFLOW_API_TARGET=https://localhost:7258
# TASKFLOW_HTTPS_PFX=<absolute path to ignored localhost.pfx>
# TASKFLOW_HTTPS_PASSWORD=<local export password>
# TASKFLOW_API_CA=<absolute path to ignored localhost.pem public certificate>
