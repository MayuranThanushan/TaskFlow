# Development server only; not exposed as a VITE_ browser variable.
TASKFLOW_API_TARGET=http://localhost:5140
# Local company UI. Development backend enables matching company gates.
# Production still requires explicit coordinated build/server flags.
VITE_WORKSPACES_ENABLED=true
# Requires backend WorkspaceLifecycle:Enabled; closes legacy resource navigation.
VITE_WORKSPACE_LIFECYCLE_ENABLED=true
# Local/Development supports HTTP by default. For HTTPS use both Vite and API HTTPS.
# See docs/transport.md for Local/UAT/Production transport overrides.
# TASKFLOW_API_TARGET=https://localhost:7258
# TASKFLOW_HTTPS_PFX=<absolute path to ignored localhost.pfx>
# TASKFLOW_HTTPS_PASSWORD=<local export password>
# TASKFLOW_API_CA=<absolute path to ignored localhost.pem public certificate>

# Invitation UI requires lifecycle mode and backend Invitations:Enabled.
VITE_INVITATIONS_ENABLED=false

# Recipient inbox requires lifecycle mode and backend Notifications:Enabled.
VITE_NOTIFICATIONS_ENABLED=false

VITE_COMMENTS_ENABLED=false

VITE_TASK_WATCHERS_ENABLED=false
