# Non-secret Compose configuration. Copy to ignored .env.deploy.
TASKFLOW_HOST=localhost
TASKFLOW_BIND_ADDRESS=127.0.0.1
TASKFLOW_HTTPS_PORT=8443
# Absolute directory outside version control; see docs/deployment.md.
TASKFLOW_DEPLOY_SECRETS_DIR=/absolute/path/to/taskflow-secrets

# Pin app and migration images to the same reviewed release tag (usually a commit).
TASKFLOW_RELEASE_TAG=local

# Reviewed company/invitation preview only; these do not enable real email sending.
# Frontend settings are build-time and require rebuilding the app image.
VITE_WORKSPACES_ENABLED=false
VITE_WORKSPACE_LIFECYCLE_ENABLED=false
VITE_INVITATIONS_ENABLED=false
# Backend settings are independent runtime authorization gates.
TASKFLOW_WORKSPACE_READS_ENABLED=false
TASKFLOW_WORKSPACE_WRITES_ENABLED=false
TASKFLOW_WORKSPACE_LIFECYCLE_ENABLED=false
TASKFLOW_INVITATIONS_ENABLED=false
