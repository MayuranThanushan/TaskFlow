{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "WorkspaceReads": { "Enabled": false },
  "WorkspaceWrites": { "Enabled": false },
  "WorkspaceLifecycle": { "Enabled": false },
  "Telemetry": {
    "TraceSampleRatio": 0.1,
    "Otlp": {
      "Enabled": false,
      "AllowInsecureLoopback": false,
      "TimeoutMilliseconds": 3000,
      "MetricIntervalMilliseconds": 30000
    }
  }
}
